# PBL Central - Environment Configuration
# Default values are configured for immediate zero-cost local execution with SQLite fallback.

# Database
# Local SQLite default: sqlite:///./pbl_central.db
# PostgreSQL Docker default: postgresql://pbl_user:pbl_password@localhost:5432/pbl_db
DATABASE_URL=sqlite:///./pbl_central.db

# JWT Security
JWT_SECRET=college_pbl_central_secure_secret_key_2026_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Demo Mode & Notifications
DEMO_MODE=true

# Optional SMTP Settings (Only needed if DEMO_MODE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@college.edu
